# Copy to config.env and edit. config.env is gitignored — it holds secrets.
#
# Every value here is also read by the per-host scripts, which source this file
# verbatim. Keep it to plain KEY=value lines.

# ---------------------------------------------------------------- panel host
# The CPX62 that runs the Panel, the billing front-end, and (optionally) Wings.
PANEL_HOST=203.0.113.10                  # SSH target (IP or hostname)
PANEL_FQDN=panel.example.com             # DNS A record -> PANEL_HOST
PANEL_URL=https://panel.example.com      # used when registering nodes
PANEL_ADMIN_EMAIL=you@example.com
PANEL_ADMIN_USER=admin
# PANEL_ADMIN_PASSWORD=                  # omit to auto-generate (saved on the host)

# Also run Wings on the panel host so it can host game servers itself.
PANEL_HOST_IS_NODE=true
PANEL_NODE_NAME=ptero-node-panel
PANEL_NODE_FQDN=node-panel.example.com   # separate A record -> PANEL_HOST

# ------------------------------------------------------------------- billing
INSTALL_BILLING=true
BILLING_FQDN=billing.example.com         # DNS A record -> PANEL_HOST
BILLING_ADMIN_EMAIL=you@example.com
# BILLING_ADMIN_PASSWORD=                # omit to auto-generate

# --------------------------------------------------------------------- nodes
# One per line: <node-name> <ssh-host> <fqdn>
# The fqdn needs its own A record and a valid certificate when NODE_SCHEME=https,
# because Wings is contacted directly by the browser for console and file access.
NODES="
ptero-node-1 203.0.113.11 node1.example.com
ptero-node-2 203.0.113.12 node2.example.com
ptero-node-3 203.0.113.13 node3.example.com
"

NODE_SCHEME=https
NODE_LISTEN_PORT=8080
NODE_SFTP_PORT=2022
GAME_PORT_RANGE=25565-25700              # allocations created on every node
NODE_MEMORY_OVERALLOCATE=0
NODE_DISK_OVERALLOCATE=0
# NODE_MEMORY / NODE_DISK default to 85% of what each host actually has.

# ----------------------------------------------------------------- panel API
# Create at <panel>/admin/api with read/write on Nodes, Locations, Allocations.
# Needed only by './deploy.sh register'.
PTERO_APP_KEY=

# ------------------------------------------------------------------- general
TIMEZONE=UTC
LETSENCRYPT_EMAIL=you@example.com        # empty disables automatic TLS
ENABLE_UFW=false                         # Hetzner Cloud Firewalls are used instead

# ----------------------------------------------------------------------- ssh
SSH_USER=root
# SSH_KEY=~/.ssh/id_ed25519

# Publish the install log at http://<host>/bootstrap.log while a host
# provisions without SSH. Served on port 80 (not a custom port) so it is
# reachable from restrictive networks. Removed after a successful run.
# Leave false in normal use — it is world-readable while it is up.
BOOTSTRAP_PUBLISH_LOG=false
