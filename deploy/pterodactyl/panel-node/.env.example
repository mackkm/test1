# Copy to .env and fill in (install.sh does this for you and generates the
# passwords automatically - you shouldn't need to edit this by hand).

# DNS: both of these must already point (A/AAAA record) at this VM's public
# IP before you run install.sh, or Caddy will fail to obtain certificates.
PANEL_DOMAIN=panel.example.com
BILLING_DOMAIN=billing.example.com

# Used only for Let's Encrypt expiry notices, never shown to customers.
ACME_EMAIL=you@example.com

PANEL_DB_PASSWORD=
PANEL_DB_ROOT_PASSWORD=
PAYMENTER_DB_PASSWORD=
PAYMENTER_DB_ROOT_PASSWORD=
